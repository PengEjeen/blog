---
import '../styles/style.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { serializeJsonLd } from '../utils/seo';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  jsonLd?: unknown | unknown[];
}

const {
  title,
  description = '개발 공부 중 배운 것들을 정리하고 경험을 아카이빙하는 개인 블로그입니다.',
  ogImage,
  noIndex = false,
  jsonLd = [],
} = Astro.props;

const SITE_NAME = "PenGejeen's Blog";
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`${baseUrl}/rss.xml`} />
    <link rel="sitemap" href={`${baseUrl}/sitemap.xml`} />

    {
      jsonLdItems.map((item) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />
      ))
    }

  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <div class="page-frame">
      <div class="app-container">
        <Header />
        <div class="layout">
          <Sidebar />
          <main id="main-content" class="main-content" tabindex="-1">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
    </div>

    <script is:inline>
      // Sidebar open/close — body class toggle. Header hamburger and backdrop dispatch events.
      (function () {
        var body = document.body;
        function close() { body.classList.remove('sidebar-open'); }
        function toggle() { body.classList.toggle('sidebar-open'); }
        document.addEventListener('click', function (e) {
          var t = e.target.closest('[data-sidebar-toggle]');
          if (t) { e.preventDefault(); toggle(); return; }
          var c = e.target.closest('[data-sidebar-close]');
          if (c) { e.preventDefault(); close(); return; }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close();
        });
        // Close sidebar on navigation (link inside sidebar).
        document.addEventListener('click', function (e) {
          var link = e.target.closest('.sidebar a[href]');
          if (link) close();
        });
      })();
    </script>

  </body>
</html>
