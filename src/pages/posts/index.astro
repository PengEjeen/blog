---
import {
  ArrowLeft,
  ArrowUpRight,
  CalendarDays,
  RotateCcw,
  Search,
  SlidersHorizontal,
} from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import {
  buildPostHref,
  getPostsIndex,
  humanize,
  type PostMeta,
} from '../../utils/posts';
import { createBreadcrumbJsonLd } from '../../utils/seo';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
const { categories, posts, total } = await getPostsIndex();

interface YearGroup {
  year: string;
  posts: PostMeta[];
}

const groupsByYear = new Map<string, PostMeta[]>();
for (const post of posts) {
  const parsedDate = new Date(post.dateRaw);
  const year = Number.isNaN(parsedDate.getTime())
    ? '날짜 미정'
    : String(parsedDate.getFullYear());
  const yearPosts = groupsByYear.get(year) ?? [];
  yearPosts.push(post);
  groupsByYear.set(year, yearPosts);
}

const yearGroups: YearGroup[] = Array.from(groupsByYear, ([year, yearPosts]) => ({
  year,
  posts: yearPosts,
}));
const yearOptions = yearGroups
  .map((group) => group.year)
  .filter((year) => year !== '날짜 미정');
const jsonLd = createBreadcrumbJsonLd([
  { name: '홈', url: new URL(`${baseUrl}/`, Astro.site).toString() },
  { name: '전체 글', url: new URL(`${baseUrl}/posts/`, Astro.site).toString() },
]);
---

<Layout
  title="전체 글"
  description={`PenGejeen's Blog에 작성한 개발 및 여행 기록 ${total}개를 최신순으로 모았습니다.`}
  jsonLd={jsonLd}
>
  <div class="all-posts-page">
    <header class="all-posts-header">
      <a href={`${baseUrl}/`} class="back-btn">
        <ArrowLeft size={16} /> 메인으로
      </a>
      <div class="all-posts-heading-row">
        <div>
          <p class="all-posts-eyebrow">Archive</p>
          <h1 class="all-posts-title">전체 글</h1>
          <p class="all-posts-subtitle">새로 쓴 글부터 차례대로 모았습니다.</p>
        </div>
        <div class="all-posts-count" aria-label={`전체 게시글 ${total}개`}>
          <strong>{total}</strong>
          <span>posts</span>
        </div>
      </div>
    </header>

    <div class="all-posts-tools" role="search" aria-label="전체 글 검색 및 필터">
      <label class="all-posts-search-field">
        <span class="all-posts-tool-label">글 검색</span>
        <span class="all-posts-input-wrap">
          <Search size={17} aria-hidden="true" />
          <input
            type="search"
            class="all-posts-search-input"
            placeholder="제목이나 내용으로 검색"
            autocomplete="off"
            data-post-search
          />
        </span>
      </label>

      <label class="all-posts-filter-field">
        <span class="all-posts-tool-label">카테고리</span>
        <select class="all-posts-select" data-category-filter>
          <option value="all">모든 카테고리</option>
          {categories.map((category) => (
            <option value={category.slug}>{humanize(category.slug)}</option>
          ))}
        </select>
      </label>

      <label class="all-posts-filter-field">
        <span class="all-posts-tool-label">연도</span>
        <select class="all-posts-select" data-year-filter>
          <option value="all">모든 연도</option>
          {yearOptions.map((year) => (
            <option value={year}>{year}년</option>
          ))}
        </select>
      </label>

      <button type="button" class="all-posts-reset" data-filter-reset>
        <RotateCcw size={14} aria-hidden="true" />
        초기화
      </button>

      <p class="all-posts-result-count" aria-live="polite" data-result-count>
        전체 {total}개의 글
      </p>
    </div>

    <div class="all-posts-archive" data-posts-archive>
      {
        yearGroups.map((group) => (
          <section
            class="all-posts-year"
            aria-labelledby={`year-${group.year}`}
            data-year-section
          >
            <div class="all-posts-year-heading">
              <h2 id={`year-${group.year}`}>{group.year}</h2>
              <span data-year-count>{group.posts.length}개의 글</span>
            </div>

            <ol class="all-posts-list">
              {group.posts.map((post) => (
                <li
                  data-post-item
                  data-search={post.searchHay}
                  data-category={post.cat}
                  data-year={group.year}
                >
                  <a href={`${baseUrl}${buildPostHref(post)}`} class="all-posts-item">
                    <time class="all-posts-date" datetime={post.dateRaw}>
                      <CalendarDays size={14} aria-hidden="true" />
                      {post.dateLabel}
                    </time>
                    <span class="all-posts-item-main">
                      <strong class="all-posts-item-title">{post.title}</strong>
                      <span class="all-posts-path">
                        {humanize(post.cat)} <span aria-hidden="true">/</span> {humanize(post.sub)}
                      </span>
                    </span>
                    <ArrowUpRight className="all-posts-arrow" size={17} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <div class="all-posts-empty" hidden data-filter-empty>
      <SlidersHorizontal size={28} aria-hidden="true" />
      <strong>조건에 맞는 글이 없습니다.</strong>
      <p>검색어를 줄이거나 필터를 초기화해 보세요.</p>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    var searchInput = document.querySelector('[data-post-search]');
    var categoryFilter = document.querySelector('[data-category-filter]');
    var yearFilter = document.querySelector('[data-year-filter]');
    var resetButton = document.querySelector('[data-filter-reset]');
    var resultCount = document.querySelector('[data-result-count]');
    var emptyState = document.querySelector('[data-filter-empty]');
    var postItems = Array.from(document.querySelectorAll('[data-post-item]'));
    var yearSections = Array.from(document.querySelectorAll('[data-year-section]'));
    var total = postItems.length;

    if (!searchInput || !categoryFilter || !yearFilter) return;

    function normalize(value) {
      return String(value || '').trim().toLocaleLowerCase('ko-KR');
    }

    function updateYearSections() {
      yearSections.forEach(function (section) {
        var visiblePosts = section.querySelectorAll('[data-post-item]:not([hidden])').length;
        section.hidden = visiblePosts === 0;
        var count = section.querySelector('[data-year-count]');
        if (count) count.textContent = visiblePosts + '개의 글';
      });
    }

    function applyFilters() {
      var query = normalize(searchInput.value);
      var selectedCategory = categoryFilter.value;
      var selectedYear = yearFilter.value;
      var visibleCount = 0;

      postItems.forEach(function (item) {
        var matchesSearch = !query || normalize(item.dataset.search).includes(query);
        var matchesCategory = selectedCategory === 'all' || item.dataset.category === selectedCategory;
        var matchesYear = selectedYear === 'all' || item.dataset.year === selectedYear;
        var isVisible = matchesSearch && matchesCategory && matchesYear;
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      updateYearSections();
      if (resultCount) {
        resultCount.textContent = visibleCount === total
          ? '전체 ' + total + '개의 글'
          : total + '개 중 ' + visibleCount + '개의 글';
      }
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    }

    function resetFilters() {
      searchInput.value = '';
      categoryFilter.value = 'all';
      yearFilter.value = 'all';
      applyFilters();
      searchInput.focus();
    }

    searchInput.addEventListener('input', applyFilters);
    categoryFilter.addEventListener('change', applyFilters);
    yearFilter.addEventListener('change', applyFilters);
    if (resetButton) resetButton.addEventListener('click', resetFilters);
  })();
</script>


<style>
  /* DESIGN.md catalog treatment; kept separate from the filtering behavior above. */
  .all-posts-page {
    width: 100%;
  }

  .all-posts-header {
    margin-bottom: 16px;
  }

  .all-posts-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .all-posts-eyebrow {
    margin-bottom: 4px;
    color: #000;
    font: 700 13px/1 Helvetica, Arial, sans-serif;
    letter-spacing: 0.08em;
  }

  .all-posts-title {
    font: 900 clamp(32px, 3.4vw, 48px)/1.08 "Arial Black", Arial, sans-serif;
    letter-spacing: -0.04em;
  }

  .all-posts-subtitle {
    margin-top: 5px;
    color: #000;
    font: 400 16px/1.5 "Times New Roman", Times, serif;
  }

  .all-posts-count {
    display: flex;
    flex: none;
    align-items: baseline;
    gap: 6px;
    padding: 5px 7px;
    border: 1px solid #000;
    background: #fcc20f;
    color: #000;
    font-family: Helvetica, Arial, sans-serif;
  }

  .all-posts-count strong {
    color: #000;
    font: 900 26px/1 "Arial Black", Arial, sans-serif;
  }

  .all-posts-count span {
    font-size: 12px;
  }

  .all-posts-tools {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(130px, 0.35fr) minmax(110px, 0.25fr) auto;
    align-items: end;
    gap: 7px;
    margin-bottom: 20px;
    padding: 8px;
    border: 1px solid #000;
    border-radius: 0;
    background: #b3bd95;
  }

  .all-posts-search-field {
    grid-column: auto;
  }

  .all-posts-search-field,
  .all-posts-filter-field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 7px;
  }

  .all-posts-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .all-posts-input-wrap :global(svg) {
    position: absolute;
    left: 12px;
    pointer-events: none;
  }

  .all-posts-tool-label {
    color: #000;
    font: 700 13px/1 Helvetica, Arial, sans-serif;
  }

  .all-posts-search-input,
  .all-posts-select,
  .all-posts-reset {
    width: 100%;
    min-height: 44px;
    border: 1px solid #000;
    border-radius: 0;
    background: #fff;
    color: #000;
    font-family: "Times New Roman", Times, serif;
    font-size: 16px;
    transition: none;
  }

  .all-posts-search-input {
    padding: 10px 12px 10px 40px;
  }

  .all-posts-select {
    padding: 10px 34px 10px 12px;
  }

  .all-posts-search-input:focus,
  .all-posts-select:focus {
    border-color: #000;
    box-shadow: none;
    outline: 3px solid #fcc20f;
    outline-offset: 2px;
  }

  .all-posts-reset {
    display: inline-flex;
    grid-column: auto;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    gap: 6px;
    background: #000;
    color: #fff;
    font: 700 14px/1 Helvetica, Arial, sans-serif;
  }

  .all-posts-reset:hover,
  .all-posts-reset:focus-visible {
    border-color: #000;
    background: #000;
    color: #fff;
  }

  .all-posts-result-count {
    grid-column: 1 / -1;
    margin: 0;
    color: #000;
    font: 400 14px/1.3 "Times New Roman", Times, serif;
  }

  .all-posts-archive {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 24px;
  }

  .all-posts-year[hidden],
  .all-posts-empty[hidden],
  .all-posts-list > li[hidden] {
    display: none;
  }

  .all-posts-year {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(96px, 112px) minmax(0, 1fr);
    gap: 16px;
  }

  .all-posts-year-heading {
    position: sticky;
    top: 12px;
    align-self: start;
    padding: 6px;
    border: 1px solid #000;
    background: #6a26a4;
    color: #fff;
  }

  .all-posts-year-heading h2 {
    font: 900 18px/1 "Arial Black", Arial, sans-serif;
  }

  .all-posts-year-heading span {
    display: block;
    margin-top: 4px;
    color: #fff;
    font-size: 12px;
  }

  .all-posts-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 1px solid #000;
    border-bottom: 0;
    list-style: none;
  }

  .all-posts-list > li {
    min-width: 0;
  }

  .all-posts-item {
    display: grid;
    width: 100%;
    min-width: 0;
    grid-template-columns: 115px minmax(0, 1fr) 20px;
    align-items: center;
    min-height: 84px;
    padding: 12px;
    gap: 12px;
    border-bottom: 1px solid #000;
    background: #fff;
    color: #0000ee;
    text-decoration: underline;
    transition: none;
  }

  .all-posts-list li:nth-child(even) .all-posts-item {
    background: #c0d4a7;
  }

  .all-posts-item:hover {
    padding-left: 12px;
    color: #0000ee;
  }

  .all-posts-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #000;
    font: 400 14px/1.3 "Times New Roman", Times, serif;
    text-decoration: none;
    white-space: nowrap;
  }

  .all-posts-item-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 5px;
  }

  .all-posts-item-title {
    display: block;
    min-width: 0;
    color: #0000ee;
    font: 700 17px/1.35 Helvetica, Arial, sans-serif;
    transition: none;
    overflow-wrap: anywhere;
  }

  .all-posts-item:hover .all-posts-item-title {
    color: #0000ee;
  }

  .all-posts-path {
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #000;
    font-size: 13px;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .all-posts-arrow,
  .all-posts-item:hover .all-posts-arrow {
    justify-self: end;
    color: #000;
    transform: none;
    transition: none;
  }

  .all-posts-empty {
    padding: 28px 14px;
    border: 1px solid #000;
    border-radius: 0;
    background: #fcc20f;
    color: #000;
    text-align: center;
  }

  .all-posts-empty strong {
    display: block;
    margin-top: 8px;
  }

  .all-posts-empty :global(svg) {
    color: #000;
    opacity: 1;
  }

  @media (max-width: 900px) {
    .all-posts-tools {
      grid-template-columns: 1fr 1fr;
    }

    .all-posts-search-field,
    .all-posts-reset {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .all-posts-year {
      grid-template-columns: 1fr;
    }

    .all-posts-year-heading {
      position: static;
      display: flex;
      align-items: baseline;
      gap: 10px;
    }

    .all-posts-year-heading span {
      margin-top: 0;
    }
  }

  @media (max-width: 479px) {
    .all-posts-heading-row {
      align-items: flex-start;
    }

    .all-posts-tools,
    .all-posts-year {
      grid-template-columns: 1fr;
    }

    .all-posts-year-heading {
      display: flex;
      gap: 8px;
    }

    .all-posts-item {
      grid-template-columns: minmax(0, 1fr) 17px;
      min-height: 76px;
    }

    .all-posts-date {
      grid-column: 1 / -1;
    }

    .all-posts-search-input,
    .all-posts-select {
      font-size: 16px;
    }
  }
</style>
