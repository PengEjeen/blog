---
import { Github, Menu, X } from 'lucide-react';
import EmailMenu from './EmailMenu.tsx';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '') || '';
---

<header class="header">
  <div class="header-content">
    <button
      type="button"
      class="header-hamburger"
      data-sidebar-toggle
      aria-label="사이드바 열기/닫기"
      aria-controls="primary-sidebar"
    >
      <span class="hamburger-icon hamburger-icon--open" aria-hidden="true"><Menu size={18} /></span>
      <span class="hamburger-icon hamburger-icon--close" aria-hidden="true"><X size={18} /></span>
    </button>

    <a href={`${baseUrl}/`} class="logo">
      <span class="logo-kicker">THE PERSONAL TECH CATALOG</span>
      <span class="logo-title">PENGEJEEN.COM</span>
    </a>

    <p class="header-promise">BUILD YOUR<br />KNOWLEDGE. ONLINE.</p>

    <a class="header-sticker" href={`${baseUrl}/posts/`}>
      <span>READ</span>
      <strong>ALL POSTS</strong>
    </a>

    <div class="header-contact" aria-label="PenGejeen 블로그">
      <span>BLOG HOTLINE</span>
      <strong>1-800-PENGEJEEN</strong>
    </div>

    <nav class="nav-links" aria-label="외부 링크">
      <a
        href="https://github.com/pengejeen"
        target="_blank"
        rel="noreferrer"
        class="nav-link"
        title="GitHub"
        aria-label="GitHub"
      >
        <Github size={17} />
      </a>
      <EmailMenu variant="icon" client:load />
    </nav>
  </div>
</header>

<style is:global>
  .hamburger-icon { display: inline-flex; align-items: center; }
  .hamburger-icon--close { display: none; }
  body.sidebar-open .hamburger-icon--open { display: none; }
  body.sidebar-open .hamburger-icon--close { display: inline-flex; }
</style>
